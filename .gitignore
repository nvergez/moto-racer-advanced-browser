# --- Copyrighted inputs and anything derived from them: never commit ---
# ROMs
*.gba
*.GBA
*.agb
roms/
# GBA BIOS
bios/
*bios*.bin
# Saves and emulator save states
*.sav
*.srm
*.ss[0-9]
*.state
# gbarecomp save states (<rom>.state1 to .state10) and interrupted save writes
*.state[0-9]*
*.sav.tmp
saves/
# Assets extracted from the ROM
extracted/
# Code generated by recompiling the ROM (it is a translation of the game's code)
generated/
# Browser bundles: game.wasm is compiled from the ROM and the BIOS. Never publish.
web-PRIVATE/
build-web-host/
# Where gbarecomp's build_web.sh writes a bundle without --embed-private-rom
# when it is run on web/game-lib directly (scripts/build-web.sh writes to build/).
/web/game-lib/web/

# --- gbarecomp runtime output, in case a run starts from the repository root ---
recomp_cache/
recomp_coverage*.json
recomp_master_misses*.toml.frag
dispatch_misses.log
diagnostics/
bios.cfg
rom.cfg
config.ini
keybinds.ini

# --- Free test ROMs, fetched by scripts/fetch-test-roms.sh ---
test-roms/

# --- Build output ---
build/
dist/
node_modules/

# --- OS / editor ---
.DS_Store
.vscode/
.idea/
