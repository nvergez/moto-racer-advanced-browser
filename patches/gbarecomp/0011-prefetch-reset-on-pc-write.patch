+// A PC write empties the GamePak prefetch buffer (mGBA GBASetActiveRegion):
+// the interpreter calls Bus::prefetch_reset after every instruction that
+// wrote R15, exception returns included, and after no other.
+struct ResetCountingBus : FlatBus {
+    int resets = 0;
+    explicit ResetCountingBus(std::size_t size) : FlatBus(size) {}
+    void prefetch_reset() override { ++resets; }
+};
+
+void expect_resets(armv4t::CPUState& cpu, ResetCountingBus& bus,
+                   const char* what, uint32_t pc, uint32_t word,
+                   int expect) {
+    bus.resets = 0;
+    cpu.R[15] = pc;
+    armv4t::Instr i{};
+    if (cpu.thumb) {
+        i = armv4t::ThumbDecoder::decode(static_cast<uint16_t>(word), pc);
+    } else {
+        i = armv4t::ArmDecoder::decode(word, pc);
+    }
+    armv4t::Interpreter::step(cpu, bus, i);
+    if (bus.resets != expect) {
+        std::printf("FAIL prefetch_reset_on_pc_write: %s reset the buffer "
+                    "%d time(s) (expected %d)\n", what, bus.resets, expect);
+        ++failures;
+    }
+}
+
+void test_prefetch_reset_on_pc_write() {
+    auto cpu = make_cpu();
+    ResetCountingBus bus(64 * 1024);
+    cpu.R[0] = 0x1000;
+    bus.write32(0x1000, 0x200);   // ldr pc, [r0] loads 0x200
+    cpu.R[13] = 0x2000;
+    bus.write32(0x2000, 0x300);   // ldmia sp!, {pc} pops 0x300
+    cpu.R[14] = 0x400;
+    expect_resets(cpu, bus, "mov r1, #5", 0x100, 0xE3A01005u, 0);
+    expect_resets(cpu, bus, "cmp r1, #6", 0x104, 0xE3510006u, 0);
+    expect_resets(cpu, bus, "beq (not taken)", 0x108, 0x0A000000u, 0);
+    expect_resets(cpu, bus, "str r1, [r0, #4]", 0x10C, 0xE5801004u, 0);
+    expect_resets(cpu, bus, "b", 0x110, 0xEA000000u, 1);
+    expect_resets(cpu, bus, "bl", 0x110, 0xEB000000u, 1);
+    expect_resets(cpu, bus, "mov pc, lr", 0x110, 0xE1A0F00Eu, 1);
+    expect_resets(cpu, bus, "ldr pc, [r0]", 0x110, 0xE590F000u, 1);
+    expect_resets(cpu, bus, "ldmia sp!, {pc}", 0x110, 0xE8BD8000u, 1);
+
+    cpu.R[1] = 0x500;             // bx r1: to ARM code at 0x500
+    cpu.R[13] = 0x2000;
+    bus.write32(0x2000, 0x601);   // pop {pc} pops 0x601 (THUMB)
+    cpu.thumb = true;
+    cpu.cpsr.t = true;
+    expect_resets(cpu, bus, "thumb mov r2, #1", 0x120, 0x2201u, 0);
+    expect_resets(cpu, bus, "thumb pop {pc}", 0x120, 0xBD00u, 1);
+    cpu.thumb = true;
+    cpu.cpsr.t = true;
+    expect_resets(cpu, bus, "thumb bx r1", 0x120, 0x4708u, 1);
+
+    cpu.thumb = false;
+    cpu.cpsr.t = false;
+    armv4t::Interpreter::enter_irq(cpu, 0x130);
+    expect_resets(cpu, bus, "movs pc, lr (exception return)", 0x18, 0xE1B0F00Eu, 1);
+}
+
