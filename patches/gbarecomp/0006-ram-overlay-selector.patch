+        reset_overlay(false, 1);
+        runtime_dispatch(pc);
+        check(select_calls == 0 && codegen_test::g_dispatch_called,
+              "non-RAM PC never reaches the selector");
+    }
+    reset_overlay(false, 1);
+    runtime_dispatch(0x02000000);
+    check(select_calls == 1, "EWRAM PC reaches the selector");
+
+    // A RAM hook that handles the transfer comes first; one that declines
+    // leaves the PC to the selector.
+    reset_overlay(false, 1);
+    g_runtime_ram_dispatch_hook = ram_hook;
+    runtime_dispatch(0x03000000);
+    check(select_calls == 0 && overlay_entry_calls == 0, "handled RAM hook wins over the selector");
+    reset_overlay(false, 1);
+    g_runtime_ram_dispatch_hook = declining_ram_hook;
+    runtime_dispatch(0x03000000);
+    check(overlay_entry_calls == 1, "declined RAM hook leaves the PC to the selector");
+    g_runtime_ram_dispatch_hook = nullptr;
+
+    // The bridge's heal-to-static check and the miss handler's heal guard.
+    reset_overlay(false, 1);
+    check(runtime_has_static_entry(0x03000000, 0) == 1, "selected entry counts as static");
+    check(runtime_has_static_entry(0x03000000, 1) == 0, "entry absent in the selected table is not static");
+    check(runtime_ram_overlay_claims(0x03000001, 1) == 1, "a claimed miss is still claimed");
+    check(runtime_ram_overlay_claims(0x08000000, 0) == 0, "ROM PCs are never claimed");
+    reset_overlay(false, -1);
+    check(runtime_has_static_entry(0x03000000, 0) == 0, "no matching image means no static entry");
+    check(runtime_ram_overlay_claims(0x03000000, 0) == 1, "no matching image is claimed");
+    reset_overlay(false, 0);
+    check(runtime_has_static_entry(0x03000000, 0) == 0 &&
+              runtime_ram_overlay_claims(0x03000000, 0) == 0,
+          "unclaimed PC uses the static table");
+    g_runtime_ram_overlay_select = nullptr;
+    check(runtime_ram_overlay_claims(0x03000000, 0) == 0, "no selector claims nothing");
+
+    // Per-guest state in a multiplayer context.
+    reset_overlay(false, 1);
+    gbarecomp::RuntimeArmContext captured;
+    gbarecomp::runtime_capture_arm_context(captured);
+    check(captured.ram_overlay_select == fake_selector, "context captures the selector");
+    gbarecomp::RuntimeArmContext other;
+    gbarecomp::runtime_restore_arm_context(other);
+    check(g_runtime_ram_overlay_select == nullptr, "restoring a context without a selector clears it");
+    gbarecomp::runtime_restore_arm_context(captured);
+    check(g_runtime_ram_overlay_select == fake_selector, "restoring a context reinstates its selector");
+
+    // With a resumable context, the session's RAM boundary runs before the
+    // selector reads memory, and a claimed miss throws instead of bridging.
+    gbarecomp::RuntimeArmContext guest;
+    guest.ram_dispatch_boundary = record_boundary;
+    reset_overlay(false, 1);
+    boundary_calls = selects_before_boundary = 0;
+    gbarecomp::runtime_set_resumable_context(&guest);
+    runtime_dispatch(0x03000000);
+    check(boundary_calls == 1 && selects_before_boundary == 0 && overlay_entry_calls == 1,
+          "multiplayer boundary precedes the selector, then the entry runs");
+    bool threw = false;
+    reset_overlay(true, 1);
+    try { runtime_dispatch(0x03000000); } catch (const std::logic_error&) { threw = true; }
+    check(threw && !codegen_test::g_dispatch_called,
+          "multiplayer claimed miss throws instead of bridging");
+    gbarecomp::runtime_set_resumable_context(nullptr);
+    g_runtime_ram_overlay_select = nullptr;
+}
