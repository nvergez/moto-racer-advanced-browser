+    const void* table = nullptr;
+    unsigned len = 0;
+    const int sel = g_runtime_ram_overlay_select(pc, thumb ? 1 : 0, &table, &len);
+    if (sel == 0) return false;
+    *entry = (sel > 0 && table)
+        ? lookup_in(static_cast<const DispatchEntry*>(table), len, pc, thumb)
+        : nullptr;
