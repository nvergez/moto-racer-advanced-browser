index 0000000..dbbe28d
--- /dev/null
+++ b/src/runtime/frame_capture.h
@@ -0,0 +1,80 @@
+// frame_capture.h — GBARECOMP_CAPTURE: env-gated, observation-only records of
+// the machine state at every VBlank start and at every rendered scanline, for
+// differential tests against another emulator or another gbarecomp backend.
+//
+// Off unless GBARECOMP_CAPTURE is set. When on, it reads guest memory, IO and
+// the latched framebuffer and writes files; it never writes guest state and
+// never changes timing. The variables, read once by init():
+//
+//   GBARECOMP_CAPTURE=PATH|-       per-frame records (TSV with a header row)
+//                                  to PATH, or to standard output with every
+//                                  line prefixed "[capture] " (for the
+//                                  browser, where stdout is the console)
+//   GBARECOMP_CAPTURE_FRAMES=L     frames that get a record (default: all)
+//   GBARECOMP_CAPTURE_SPEC=TEXT    capture spec, inline; "@FILE" reads a file
+//   GBARECOMP_CAPTURE_MEM=L        extra memory fields, ADDR:SIZE (1, 2 or 4)
+//   GBARECOMP_CAPTURE_LINES=L      frames whose full line records are written
+//   GBARECOMP_CAPTURE_FIFO=L       frames whose FIFO A/B bytes are written
+//   GBARECOMP_CAPTURE_RAW=L        frames whose framebuffer is dumped raw
+//   GBARECOMP_CAPTURE_LINE_STATE=0 skip the per-line state ("lines" is "-")
+//
+// A list L holds frames and ranges ("1-3000;4200"), separated by ';', ',' or
+// spaces (the browser's ?env= splits on ',', so use ';' there). Full records
+// are file-sink only and go next to PATH, with a trailing ".tsv" removed:
+// STEM.lines.tsv, STEM.fifo.tsv and STEM.raw/fNNNNNN.bgr555.
+//
+// Frame numbering: a record is taken at VBlank start while the PPU's
+// frame_count() is k and is numbered k+1, the value a VBlank-counting
+// emulator (mGBA) has just reached. Line records of frame k+1 are the visible
+// lines rendered before that VBlank.
+//
+// Spec: one entry per line or per ';'; '#' starts a comment that runs to the
+// end of the line. Numbers are decimal or 0x hexadecimal.
+//   reg NAME MASK         AND MASK into register NAME in line records
+//   ram NAME FIRST-LAST   hash this EWRAM or IWRAM range as column ram_NAME
+//                         (at most 64 regions)
+//   mask NAME FIRST-LAST  zero these bytes of region NAME before hashing
+//                         (at most 128 masks)
+//   mem ADDR:SIZE         record this EWRAM/IWRAM value as column mem_ADDR
+//                         (at most 32 fields, with GBARECOMP_CAPTURE_MEM)
+//
+// Per-frame columns: frame, fb (CRC-32 of the 240x160 frame as little-endian
+// BGR555 words, each channel the top 5 bits of the 8-bit output), lines
+// (CRC-32 of the frame's line records, as text), DISPCNT, mem_*, ram_*,
+// fifo_a_n, fifo_a, fifo_b_n, fifo_b (bytes written to FIFO A/B by the CPU
+// and DMA since the previous record, and their CRC-32), io_writes and
+// halt_writes (committed IO-register writes, and those covering HALTCNT,
+// since the previous record), cycles (master clock) and bridge_insns
+// (instructions the interpreter bridge ran since the previous record).
+// CRC-32 is zlib's. The format is shared with an mGBA-based harness; change
+// both together.
+
+#pragma once
+
+#include <cstdint>
+
+namespace gba { class GbaBus; class GbaPpu; }
+
+namespace gbarecomp::capture {
+
+extern bool g_on;  // true once init() armed the capture
+
+// Read the variables above and open the sinks. Call once before the guest
+// runs. Does nothing and returns true when GBARECOMP_CAPTURE is unset;
+// returns false, after printing why, when a variable is malformed.
+bool init();
+
+inline bool on() { return g_on; }
+
+// Called right before the PPU renders visible line ppu.vcount().
+void line(const gba::GbaPpu& ppu, const gba::GbaBus& bus);
+
+// Called at VBlank start, after the framebuffer latch and before the
+// VBlank-timed DMA, the VBlank input hook and the VBlank IRQ.
+void vblank(const gba::GbaPpu& ppu, const gba::GbaBus& bus);
+
+// Flush and close the sinks. Records are flushed after every frame too, so a
+// run that aborts keeps the frames it captured.
+void finish();
+
+}  // namespace gbarecomp::capture
