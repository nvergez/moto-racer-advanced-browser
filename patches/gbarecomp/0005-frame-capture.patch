+namespace gbarecomp::capture {
+
+bool g_on = false;
+
+namespace {
+
+// ── CRC-32 (zlib's: reflected 0xEDB88320, crc32(crc, buf, len) semantics),
+// slice-by-8 so hashing 288 KiB of RAM per frame stays cheap.
+struct CrcTables {
+    uint32_t t[8][256];
+    constexpr CrcTables() : t{} {
+        for (uint32_t i = 0; i < 256; ++i) {
+            uint32_t c = i;
+            for (int k = 0; k < 8; ++k) c = (c & 1u) ? (0xEDB88320u ^ (c >> 1)) : (c >> 1);
+            t[0][i] = c;
+        }
+        for (uint32_t i = 0; i < 256; ++i)
+            for (int s = 1; s < 8; ++s)
+                t[s][i] = (t[s - 1][i] >> 8) ^ t[0][t[s - 1][i] & 0xFFu];
+    }
+};
+constexpr CrcTables kCrc{};
+
+uint32_t crc32(uint32_t crc, const void* data, std::size_t n) {
+    const uint8_t* p = static_cast<const uint8_t*>(data);
+    uint32_t c = ~crc;
+    while (n >= 8) {
+        const uint32_t a = c ^ (uint32_t(p[0]) | uint32_t(p[1]) << 8 |
+                                uint32_t(p[2]) << 16 | uint32_t(p[3]) << 24);
+        const uint32_t b = uint32_t(p[4]) | uint32_t(p[5]) << 8 |
+                           uint32_t(p[6]) << 16 | uint32_t(p[7]) << 24;
+        c = kCrc.t[7][a & 0xFFu] ^ kCrc.t[6][(a >> 8) & 0xFFu] ^
+            kCrc.t[5][(a >> 16) & 0xFFu] ^ kCrc.t[4][a >> 24] ^
+            kCrc.t[3][b & 0xFFu] ^ kCrc.t[2][(b >> 8) & 0xFFu] ^
+            kCrc.t[1][(b >> 16) & 0xFFu] ^ kCrc.t[0][b >> 24];
+        p += 8;
+        n -= 8;
+    }
+    while (n--) c = kCrc.t[0][(c ^ *p++) & 0xFFu] ^ (c >> 8);
+    return ~c;
+}
+
+uint32_t crc32_zeros(uint32_t crc, std::size_t n) {
+    static const uint8_t zeros[256] = {};
+    while (n) {
+        const std::size_t k = n < sizeof(zeros) ? n : sizeof(zeros);
+        crc = crc32(crc, zeros, k);
+        n -= k;
+    }
+    return crc;
+}
+
+// ── The registers of a line record, in column order (offsets from 0x04000000).
+struct LineReg {
+    const char* name;
+    uint16_t off;
+    uint8_t size;
+};
+constexpr LineReg kLineRegs[] = {
+    {"DISPCNT", 0x000, 2}, {"BG0CNT", 0x008, 2},  {"BG1CNT", 0x00A, 2},
+    {"BG2CNT", 0x00C, 2},  {"BG3CNT", 0x00E, 2},  {"BG0HOFS", 0x010, 2},
+    {"BG0VOFS", 0x012, 2}, {"BG1HOFS", 0x014, 2}, {"BG1VOFS", 0x016, 2},
+    {"BG2HOFS", 0x018, 2}, {"BG2VOFS", 0x01A, 2}, {"BG3HOFS", 0x01C, 2},
+    {"BG3VOFS", 0x01E, 2}, {"BG2PA", 0x020, 2},   {"BG2PB", 0x022, 2},
+    {"BG2PC", 0x024, 2},   {"BG2PD", 0x026, 2},   {"BG2X", 0x028, 4},
+    {"BG2Y", 0x02C, 4},    {"BG3PA", 0x030, 2},   {"BG3PB", 0x032, 2},
+    {"BG3PC", 0x034, 2},   {"BG3PD", 0x036, 2},   {"BG3X", 0x038, 4},
+    {"BG3Y", 0x03C, 4},    {"WIN0H", 0x040, 2},   {"WIN0V", 0x044, 2},
+    {"WIN1H", 0x042, 2},   {"WIN1V", 0x046, 2},   {"WININ", 0x048, 2},
+    {"WINOUT", 0x04A, 2},  {"BLDCNT", 0x050, 2},  {"BLDALPHA", 0x052, 2},
+    {"BLDY", 0x054, 2},    {"MOSAIC", 0x04C, 2},
+};
+constexpr std::size_t kNumLineRegs = sizeof(kLineRegs) / sizeof(kLineRegs[0]);
+
+constexpr std::size_t kMaxRam = 64, kMaxMasks = 128, kMaxMem = 32;
+constexpr unsigned kWidth = 240, kHeight = 160;
+
+struct Range {
+    uint64_t first, last;
+};
+
+// A frame list: "1-3000;4200". all = no list given where the default is all.
+struct FrameList {
+    bool all = false;
+    std::vector<Range> ranges;
+    bool has(uint64_t f) const {
+        if (all) return true;
+        for (const Range& r : ranges)
+            if (f >= r.first && f <= r.last) return true;
+        return false;
+    }
+    bool empty() const { return !all && ranges.empty(); }
+};
+
+struct RamRegion {
+    std::string name;
+    uint32_t first = 0, last = 0;
+    std::vector<Range> masks;  // sorted, inside [first, last]
+};
+
+struct MemField {
+    uint32_t addr = 0;
+    unsigned size = 0;
+};
+
+// CRC of a memory block, recomputed only when its bytes differ from the copy
+// taken at the last computation (memcmp is much cheaper than CRC, and video
+// memory changes on few lines per frame).
+struct CachedCrc {
+    std::vector<uint8_t> shadow;
+    uint32_t crc = 0;
+    bool valid = false;
+    uint32_t get(const uint8_t* p, std::size_t n) {
+        if (valid && shadow.size() == n && std::memcmp(shadow.data(), p, n) == 0) return crc;
+        shadow.assign(p, p + n);
+        crc = crc32(0, p, n);
+        valid = true;
+        return crc;
+    }
+};
+
+struct State {
+    std::FILE* out = nullptr;
+    bool to_stdout = false;
+    std::string stem;
+    std::FILE* lines_out = nullptr;
+    std::FILE* fifo_out = nullptr;
+    std::string raw_dir;
+    FrameList frames, lines_frames, fifo_frames, raw_frames;
+    bool line_state = true;
+    uint32_t reg_mask[kNumLineRegs];
+    std::vector<RamRegion> ram;
+    std::vector<MemField> mem;
+    std::string header;
+    // Accumulated since the previous VBlank-start record.
+    uint32_t lines_crc = 0;
+    uint64_t fifo_n[2] = {0, 0};
+    uint32_t fifo_crc[2] = {0, 0};
+    std::vector<uint8_t> fifo_bytes[2];
+    uint64_t io_writes = 0, halt_writes = 0;
+    uint64_t bridge_prev = 0;
+    CachedCrc oam, pal, vram_bg, vram_obj;
+    uint16_t fb[kWidth * kHeight];
+    std::string rec;
+};
+State* S = nullptr;
+
+// ── Parsing ────────────────────────────────────────────────────────────────
+
+bool fail(const char* what, const std::string& detail) {
+    std::fprintf(stderr, "[capture] %s: %s\n", what, detail.c_str());
+    return false;
+}
+
+// Decimal, or hexadecimal with 0x (never octal), and nothing after it.
+bool parse_u64(const std::string& s, uint64_t& out) {
+    if (s.empty() || !std::isdigit(static_cast<unsigned char>(s[0]))) return false;
+    const bool hex = s.size() > 1 && s[0] == '0' && (s[1] == 'x' || s[1] == 'X');
+    char* end = nullptr;
+    errno = 0;
+    const unsigned long long v = std::strtoull(s.c_str(), &end, hex ? 16 : 10);
+    if (errno || !end || *end) return false;
+    out = v;
+    return true;
+}
+
+bool parse_range(const std::string& s, Range& r) {
+    const std::size_t dash = s.find('-');
+    if (dash == std::string::npos) {
+        if (!parse_u64(s, r.first)) return false;
+        r.last = r.first;
+        return true;
+    }
+    return parse_u64(s.substr(0, dash), r.first) &&
+           parse_u64(s.substr(dash + 1), r.last) && r.first <= r.last;
+}
+
+std::vector<std::string> split(const std::string& s, const char* seps) {
+    std::vector<std::string> out;
+    std::string cur;
+    for (char c : s) {
+        if (std::strchr(seps, c)) {
+            if (!cur.empty()) out.push_back(cur);
+            cur.clear();
+        } else {
+            cur.push_back(c);
+        }
+    }
+    if (!cur.empty()) out.push_back(cur);
+    return out;
+}
+
+bool parse_frames(const char* var, bool default_all, FrameList& out) {
+    const char* v = std::getenv(var);
+    if (!v || !*v) {
+        out.all = default_all;
+        return true;
+    }
+    for (const std::string& tok : split(v, ",; \t\r\n")) {
+        Range r;
+        if (!parse_range(tok, r)) return fail(var, "bad frame or range '" + tok + "'");
+        out.ranges.push_back(r);
+    }
+    return true;
+}
+
+bool in_ram(uint64_t a) {
+    return (a >= 0x02000000u && a <= 0x0203FFFFu) || (a >= 0x03000000u && a <= 0x03007FFFu);
+}
+bool same_ram(uint64_t a, uint64_t b) { return in_ram(a) && in_ram(b) && (a >> 24) == (b >> 24); }
+
+bool add_mem(const std::string& tok, State& s, const char* where) {
+    const std::size_t colon = tok.find(':');
+    uint64_t addr = 0, size = 0;
+    if (colon == std::string::npos || !parse_u64(tok.substr(0, colon), addr) ||
+        !parse_u64(tok.substr(colon + 1), size) || (size != 1 && size != 2 && size != 4) ||
+        !same_ram(addr, addr + size - 1))
+        return fail(where, "bad memory field '" + tok + "' (want ADDR:SIZE, size 1, 2 or 4, in EWRAM or IWRAM)");
+    for (const MemField& m : s.mem) {
+        if (m.addr != addr) continue;
+        if (m.size != size) return fail(where, "memory field " + tok + " given twice with different sizes");
+        return true;  // the same field twice: one column
+    }
+    if (s.mem.size() >= kMaxMem) return fail(where, "more than 32 memory fields");
+    s.mem.push_back({static_cast<uint32_t>(addr), static_cast<unsigned>(size)});
+    return true;
+}
+
+bool valid_name(const std::string& n) {
+    if (n.empty() || n.size() > 32) return false;
+    for (char c : n)
+        if (!(std::isalnum(static_cast<unsigned char>(c)) || c == '_')) return false;
+    return true;
+}
+
+bool parse_spec(const std::string& text, State& s) {
+    const char* where = "GBARECOMP_CAPTURE_SPEC";
+    std::vector<std::string> entries;
+    for (std::string line : split(text, "\n")) {
+        const std::size_t hash = line.find('#');  // a comment runs to the end of the line
+        if (hash != std::string::npos) line.resize(hash);
+        for (const std::string& e : split(line, ";")) entries.push_back(e);
+    }
+    for (const std::string& entry : entries) {
+        const std::vector<std::string> t = split(entry, " \t\r");
+        if (t.empty()) continue;
+        if (t[0] == "reg" && t.size() == 3) {
+            std::size_t i = 0;
+            while (i < kNumLineRegs && t[1] != kLineRegs[i].name) ++i;
+            uint64_t mask = 0;
+            if (i == kNumLineRegs) return fail(where, "unknown line register '" + t[1] + "'");
+            if (!parse_u64(t[2], mask) || mask > 0xFFFFFFFFu) return fail(where, "bad mask '" + t[2] + "'");
+            s.reg_mask[i] &= static_cast<uint32_t>(mask);
+        } else if (t[0] == "ram" && t.size() == 3) {
+            Range r;
+            if (!valid_name(t[1])) return fail(where, "bad region name '" + t[1] + "'");
+            for (const RamRegion& g : s.ram)
+                if (g.name == t[1]) return fail(where, "region " + t[1] + " defined twice");
+            if (!parse_range(t[2], r) || !same_ram(r.first, r.last))
+                return fail(where, "bad range '" + t[2] + "' (one range inside EWRAM or IWRAM)");
+            if (s.ram.size() >= kMaxRam) return fail(where, "more than 64 ram regions");
+            RamRegion g;
+            g.name = t[1];
+            g.first = static_cast<uint32_t>(r.first);
+            g.last = static_cast<uint32_t>(r.last);
+            s.ram.push_back(g);
+        } else if (t[0] == "mask" && t.size() == 3) {
+            RamRegion* g = nullptr;
+            for (RamRegion& x : s.ram)
+                if (x.name == t[1]) g = &x;
+            Range r;
+            if (!g) return fail(where, "mask for unknown region '" + t[1] + "' (define it first)");
+            if (!parse_range(t[2], r) || r.first < g->first || r.last > g->last)
+                return fail(where, "mask '" + t[2] + "' is not inside region " + t[1]);
+            std::size_t total = 0;
+            for (const RamRegion& x : s.ram) total += x.masks.size();
+            if (total >= kMaxMasks) return fail(where, "more than 128 masks");
+            g->masks.push_back(r);
+        } else if (t[0] == "mem" && t.size() == 2) {
+            if (!add_mem(t[1], s, where)) return false;
+        } else {
+            return fail(where, "cannot parse '" + entry + "'");
+        }
+    }
+    for (RamRegion& g : s.ram) {
+        // Sort and merge, so hashing walks each region once.
+        std::vector<Range>& m = g.masks;
+        for (std::size_t i = 1; i < m.size(); ++i)
+            for (std::size_t j = i; j > 0 && m[j].first < m[j - 1].first; --j) std::swap(m[j], m[j - 1]);
+        std::vector<Range> merged;
+        for (const Range& r : m) {
+            if (!merged.empty() && r.first <= merged.back().last + 1) {
+                if (r.last > merged.back().last) merged.back().last = r.last;
+            } else {
+                merged.push_back(r);
+            }
+        }
+        m = merged;
+    }
+    return true;
+}
+
+// ── Formatting ─────────────────────────────────────────────────────────────
+
+void put_hex(std::string& s, uint32_t v, int digits) {
+    static const char kHex[] = "0123456789ABCDEF";
+    for (int i = digits - 1; i >= 0; --i) s.push_back(kHex[(v >> (4 * i)) & 0xFu]);
+}
+void put_dec(std::string& s, unsigned long long v) {
+    char b[24];
+    std::snprintf(b, sizeof(b), "%llu", v);
+    s += b;
+}
+
+void emit(std::FILE* f, bool prefixed, const std::string& line) {
+    if (prefixed) std::fputs("[capture] ", f);
+    std::fwrite(line.data(), 1, line.size(), f);
+}
+
+const uint8_t* ram_ptr(const gba::GbaBus& bus, uint32_t addr) {
+    if (addr >> 24 == 0x02) return bus.ewram_ptr() + (addr & 0x3FFFFu);
+    return bus.iwram_ptr() + (addr & 0x7FFFu);
+}
+
+uint32_t region_crc(const gba::GbaBus& bus, const RamRegion& g) {
+    uint32_t crc = 0, at = g.first;
+    for (const Range& m : g.masks) {
+        if (m.first > at) crc = crc32(crc, ram_ptr(bus, at), m.first - at);
+        crc = crc32_zeros(crc, m.last - m.first + 1);
+        at = static_cast<uint32_t>(m.last + 1);
+    }
+    if (at <= g.last) crc = crc32(crc, ram_ptr(bus, at), g.last - at + 1);
+    return crc;
+}
+
+void build_fb(const gba::GbaPpu& ppu) {
+    const uint8_t* fb = ppu.latched_framebuffer();
+    const std::size_t stride = static_cast<std::size_t>(ppu.render_width()) * 3;
+    const uint8_t* origin = fb + ppu.view_extra_top() * stride + ppu.view_extra_left() * 3;
+    for (unsigned y = 0; y < kHeight; ++y) {
+        const uint8_t* row = origin + y * stride;
+        for (unsigned x = 0; x < kWidth; ++x) {
+            const uint8_t* px = row + x * 3;
+            S->fb[y * kWidth + x] = static_cast<uint16_t>((px[0] >> 3) | ((px[1] >> 3) << 5) |
+                                                          ((px[2] >> 3) << 10));
+        }
+    }
+}
+
+void io_tap(uint32_t addr, uint32_t value, uint32_t size) {
+    const uint32_t off = addr - 0x04000000u;
+    if (off >= 0x400u || !S) return;
+    ++S->io_writes;
+    if (off <= 0x301u && off + size > 0x301u) ++S->halt_writes;
+    if (off + size <= 0xA0u || off >= 0xA8u) return;
+    for (uint32_t i = 0; i < size; ++i) {
+        const uint32_t o = off + i;
+        if (o < 0xA0u || o >= 0xA8u) continue;
+        const int ch = o >= 0xA4u ? 1 : 0;
+        const uint8_t b = static_cast<uint8_t>(value >> (8 * i));
+        ++S->fifo_n[ch];
+        S->fifo_crc[ch] = crc32(S->fifo_crc[ch], &b, 1);
+        if (S->fifo_out) S->fifo_bytes[ch].push_back(b);
+    }
+}
+
+std::string read_spec_text(const char* v, bool& ok) {
+    ok = true;
+    if (!v) return "";
+    if (v[0] != '@') return v;
+    std::ifstream in(v + 1, std::ios::binary);
+    if (!in) {
+        ok = fail("GBARECOMP_CAPTURE_SPEC", std::string("cannot read ") + (v + 1));
+        return "";
+    }
+    std::ostringstream ss;
+    ss << in.rdbuf();
+    return ss.str();
+}
+
+}  // namespace
+
+bool init() {
+    if (S) return true;
+    const char* path = std::getenv("GBARECOMP_CAPTURE");
+    if (!path || !*path) return true;
+    S = new State();
+    State& s = *S;
+    for (uint32_t& m : s.reg_mask) m = 0xFFFFFFFFu;
+    bool ok = true;
+    const std::string spec = read_spec_text(std::getenv("GBARECOMP_CAPTURE_SPEC"), ok);
+    if (!ok || !parse_spec(spec, s)) return false;
+    if (const char* extra = std::getenv("GBARECOMP_CAPTURE_MEM")) {
+        for (const std::string& tok : split(extra, ",; \t\r\n"))
+            if (!add_mem(tok, s, "GBARECOMP_CAPTURE_MEM")) return false;
+    }
+    if (!parse_frames("GBARECOMP_CAPTURE_FRAMES", true, s.frames) ||
+        !parse_frames("GBARECOMP_CAPTURE_LINES", false, s.lines_frames) ||
+        !parse_frames("GBARECOMP_CAPTURE_FIFO", false, s.fifo_frames) ||
+        !parse_frames("GBARECOMP_CAPTURE_RAW", false, s.raw_frames))
+        return false;
+    if (const char* ls = std::getenv("GBARECOMP_CAPTURE_LINE_STATE"))
+        s.line_state = !(ls[0] == '0' && ls[1] == '\0');
+
+    s.to_stdout = std::strcmp(path, "-") == 0;
+    if (s.to_stdout) {
+        s.out = stdout;
+        if (!s.lines_frames.empty() || !s.fifo_frames.empty() || !s.raw_frames.empty())
+            std::fprintf(stderr,
+                         "[capture] full line, FIFO and raw records need a file sink; "
+                         "ignoring GBARECOMP_CAPTURE_LINES/FIFO/RAW\n");
+    } else {
+        s.out = std::fopen(path, "w");
+        if (!s.out) return fail("GBARECOMP_CAPTURE", std::string("cannot write ") + path);
+        s.stem = path;
+        if (s.stem.size() > 4 && s.stem.compare(s.stem.size() - 4, 4, ".tsv") == 0)
+            s.stem.resize(s.stem.size() - 4);
+        if (!s.lines_frames.empty() && !s.line_state)
+            std::fprintf(stderr, "[capture] GBARECOMP_CAPTURE_LINE_STATE=0: "
+                                 "ignoring GBARECOMP_CAPTURE_LINES\n");
+        if (!s.lines_frames.empty() && s.line_state) {
+            const std::string p = s.stem + ".lines.tsv";
+            s.lines_out = std::fopen(p.c_str(), "w");
+            if (!s.lines_out) return fail("GBARECOMP_CAPTURE_LINES", "cannot write " + p);
+        }
+        if (!s.fifo_frames.empty()) {
+            const std::string p = s.stem + ".fifo.tsv";
+            s.fifo_out = std::fopen(p.c_str(), "w");
+            if (!s.fifo_out) return fail("GBARECOMP_CAPTURE_FIFO", "cannot write " + p);
+            std::fputs("frame\tchannel\tn\tbytes\n", s.fifo_out);
+        }
+        if (!s.raw_frames.empty()) {
+            s.raw_dir = s.stem + ".raw";
+            std::error_code ec;
+            std::filesystem::create_directories(s.raw_dir, ec);
+            if (ec) return fail("GBARECOMP_CAPTURE_RAW", "cannot create " + s.raw_dir);
+        }
+    }
+
+    std::string& h = s.header;
+    h = "frame\tfb\tlines\tDISPCNT";
+    for (const MemField& m : s.mem) {
+        h += "\tmem_";
+        put_hex(h, m.addr, 8);
+    }
+    for (const RamRegion& g : s.ram) h += "\tram_" + g.name;
+    h += "\tfifo_a_n\tfifo_a\tfifo_b_n\tfifo_b\tio_writes\thalt_writes\tcycles\tbridge_insns\n";
+    emit(s.out, s.to_stdout, h);
+    if (s.lines_out) {
+        std::string lh = "frame\tline";
+        for (const LineReg& r : kLineRegs) lh += std::string("\t") + r.name;
+        lh += "\tPAL0\tOAM\tPAL\tVRAM_BG\tVRAM_OBJ\n";
+        std::fputs(lh.c_str(), s.lines_out);
+    }
+    s.bridge_prev = self_heal_bridge_steps();
+    gba::gba_set_io_write_tap(io_tap);
+    g_on = true;
+    std::printf("capture=ENABLED path=\"%s\" ram_regions=%zu mem_fields=%zu line_state=%s\n",
+                path, s.ram.size(), s.mem.size(), s.line_state ? "on" : "off");
+    std::fflush(stdout);
+    return true;
+}
+
+void line(const gba::GbaPpu& ppu, const gba::GbaBus& bus) {
+    State& s = *S;
+    if (!s.line_state) return;
+    const uint64_t f = ppu.frame_count() + 1;
+    const bool full = s.lines_out && s.lines_frames.has(f);
+    if (!full && !s.frames.has(f)) return;
+    const uint8_t* io = bus.io().raw();
+    std::string& r = s.rec;
+    r.clear();
+    put_dec(r, f);
+    r.push_back('\t');
+    put_dec(r, ppu.vcount());
+    for (std::size_t i = 0; i < kNumLineRegs; ++i) {
+        const LineReg& g = kLineRegs[i];
+        uint32_t v = uint32_t(io[g.off]) | uint32_t(io[g.off + 1]) << 8;
+        if (g.size == 4) v |= (uint32_t(io[g.off + 2]) | uint32_t(io[g.off + 3]) << 8) << 16;
+        r.push_back('\t');
+        put_hex(r, v & s.reg_mask[i], g.size * 2);
+    }
+    const uint8_t* pal = bus.pal_ptr();
+    const uint8_t* vram = bus.vram_ptr();
+    r.push_back('\t');
+    put_hex(r, uint32_t(pal[0]) | uint32_t(pal[1]) << 8, 4);
+    r.push_back('\t');
+    put_hex(r, s.oam.get(bus.oam_ptr(), 1024), 8);
+    r.push_back('\t');
+    put_hex(r, s.pal.get(pal, 1024), 8);
+    r.push_back('\t');
+    put_hex(r, s.vram_bg.get(vram, 0x10000), 8);
+    r.push_back('\t');
+    put_hex(r, s.vram_obj.get(vram + 0x10000, 0x8000), 8);
+    r.push_back('\n');
+    s.lines_crc = crc32(s.lines_crc, r.data(), r.size());
+    if (full) std::fwrite(r.data(), 1, r.size(), s.lines_out);
+}
+
+void vblank(const gba::GbaPpu& ppu, const gba::GbaBus& bus) {
+    State& s = *S;
+    const uint64_t f = ppu.frame_count() + 1;
+    const bool record = s.frames.has(f);
+    const bool raw = !s.raw_dir.empty() && s.raw_frames.has(f);
+    uint64_t steps = self_heal_bridge_steps();
+    if (steps < s.bridge_prev) s.bridge_prev = 0;  // self_heal_reset() ran
+    if (record || raw) build_fb(ppu);
+    if (record) {
+        std::string& r = s.rec;
+        r.clear();
+        put_dec(r, f);
+        r.push_back('\t');
+        put_hex(r, crc32(0, s.fb, sizeof(s.fb)), 8);
+        r.push_back('\t');
+        if (s.line_state) put_hex(r, s.lines_crc, 8);
+        else r.push_back('-');
+        const uint8_t* io = bus.io().raw();
+        r.push_back('\t');
+        put_hex(r, uint32_t(io[0]) | uint32_t(io[1]) << 8, 4);
+        for (const MemField& m : s.mem) {
+            const uint8_t* p = ram_ptr(bus, m.addr);
+            uint32_t v = 0;
+            for (unsigned i = 0; i < m.size; ++i) v |= uint32_t(p[i]) << (8 * i);
+            r.push_back('\t');
+            put_hex(r, v, static_cast<int>(m.size * 2));
+        }
+        for (const RamRegion& g : s.ram) {
+            r.push_back('\t');
+            put_hex(r, region_crc(bus, g), 8);
+        }
+        for (int ch = 0; ch < 2; ++ch) {
+            r.push_back('\t');
+            put_dec(r, s.fifo_n[ch]);
+            r.push_back('\t');
+            put_hex(r, s.fifo_crc[ch], 8);
+        }
+        r.push_back('\t');
+        put_dec(r, s.io_writes);
+        r.push_back('\t');
+        put_dec(r, s.halt_writes);
+        r.push_back('\t');
+        put_dec(r, g_runtime_cycles);
+        r.push_back('\t');
+        put_dec(r, steps - s.bridge_prev);
+        r.push_back('\n');
+        emit(s.out, s.to_stdout, r);
+        std::fflush(s.out);
+    }
+    if (raw) {
+        char name[32];
+        std::snprintf(name, sizeof(name), "/f%06llu.bgr555", static_cast<unsigned long long>(f));
+        const std::string p = s.raw_dir + name;
+        if (std::FILE* o = std::fopen(p.c_str(), "wb")) {
+            std::fwrite(s.fb, 1, sizeof(s.fb), o);
+            std::fclose(o);
+        } else {
+            std::fprintf(stderr, "[capture] cannot write %s\n", p.c_str());
+        }
+    }
+    if (s.fifo_out && s.fifo_frames.has(f)) {
+        for (int ch = 0; ch < 2; ++ch) {
+            std::string& r = s.rec;
+            r.clear();
+            put_dec(r, f);
+            r += ch ? "\tB\t" : "\tA\t";
+            put_dec(r, s.fifo_bytes[ch].size());
+            r.push_back('\t');
+            for (uint8_t b : s.fifo_bytes[ch]) put_hex(r, b, 2);
+            if (s.fifo_bytes[ch].empty()) r.push_back('-');
+            r.push_back('\n');
+            std::fwrite(r.data(), 1, r.size(), s.fifo_out);
+        }
+        std::fflush(s.fifo_out);
+    }
+    if (s.lines_out) std::fflush(s.lines_out);
+    s.lines_crc = 0;
+    for (int ch = 0; ch < 2; ++ch) {
+        s.fifo_n[ch] = 0;
+        s.fifo_crc[ch] = 0;
+        s.fifo_bytes[ch].clear();
+    }
+    s.io_writes = s.halt_writes = 0;
+    s.bridge_prev = steps;
+}
+
+void finish() {
+    if (!S) return;
+    gba::gba_set_io_write_tap(nullptr);
+    g_on = false;
+    if (S->out && !S->to_stdout) std::fclose(S->out);
+    else if (S->out) std::fflush(S->out);
+    if (S->lines_out) std::fclose(S->lines_out);
+    if (S->fifo_out) std::fclose(S->fifo_out);
+    S->out = S->lines_out = S->fifo_out = nullptr;
+}
+
+}  // namespace gbarecomp::capture
